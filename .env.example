# =============================================
# 환경변수 설정 예시
# 이 파일을 복사해서 .env.local 로 만들고 실제 값을 채워넣으세요.
# .env.local 은 절대 Git에 커밋하지 마세요!
# =============================================

# Google Gemini API Key
# https://aistudio.google.com/apikey 에서 생성
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Supabase 설정
# https://supabase.com/dashboard/project/{project-id}/settings/api 에서 확인
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 테스트 스크립트용 (스크립트 실행 시에만 필요, VITE_ 접두사 없음)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_PROJECT_ID=your_project_id_here
SUPABASE_PAT=your_personal_access_token_here  # https://supabase.com/dashboard/account/tokens
SUPABASE_USER_ID=your_test_user_uuid_here
